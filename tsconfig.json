{
  "compilerOptions": {
    "target": "es2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./",
    "outDir": "./dist",
    "baseUrl": "./",
    "types": ["node"], 
    "paths": {
      "@/*": ["app/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["app/**/*", "app/prisma/generated"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
